# Optional. Set these in the Herdr server environment before launch if needed.
# Leave them unset to use the defaults. These paths contain no credentials.

# Root for Herdr config and the installed usage widget. Default: ~/.config.
# XDG_CONFIG_HOME=/Users/you/.config

# Root for the private usage cache. Default: ~/.local/state.
# XDG_STATE_HOME=/Users/you/.local/state

# Path to a Herdr configuration file. Default: $XDG_CONFIG_HOME/herdr/config.toml.
# HERDR_CONFIG_PATH=/Users/you/.config/herdr/config.toml

# Absolute Herdr executable path. Herdr injects it for status and plugin commands.
# Outside Herdr the widget searches PATH and standard install locations.
# HERDR_BIN_PATH=/Users/you/.local/bin/herdr

# Time zone for reset times. Default: the Herdr server's local time zone.
# TZ=Europe/Stockholm
